<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Full cache refreshes run as a WorkManager foreground service while backgrounded. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Native Brother P-touch RFCOMM printing (NBC-10). CONNECT is runtime-gated on API 31+;
         SCAN is declared for devices that require it while discovering paired printers. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />
    <!-- API 33+ runtime permission, required to post the background-sync-failure Notification
         (NBC-23) - requested at runtime from MainActivity. Notifications are silently skipped if
         this is denied (see SyncNotifier.notifySyncFailed), never a hard requirement. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <application
        android:name=".NyetboxApp"
        android:allowBackup="false"
        tools:ignore="DataExtractionRules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nyetbox"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="34">

        <!-- usesCleartextTraffic=true: self-hosted NetBox instances are frequently plain HTTP on
             a local network. Deliberate choice for this app's target audience (homelab/NetBox
             users), not an oversight - see README.md. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Nyetbox.Splash"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                 Sticker QR codes point at the public NetBox URL for that object (e.g.
                 https://<netbox-host>/dcim/devices/<id>/) - not just devices, any of NetBox's
                 object types (see NBC-6's generic list/detail screens). The host isn't known at
                 build time (it's whatever NetBox instance the user configures in Settings), so
                 this matches the path on any https host rather than a fixed one, scoped to
                 NetBox's known top-level app namespaces (core, plugins included, so
                 plugin-provided object links work too). Not auto-verified (that requires a
                 fixed, DNS-verified host), so Android offers this app in the "Open with" chooser
                 for matching links rather than opening it automatically. See docs/app-links.md.
            -->
            <intent-filter tools:ignore="AppLinkWarning,IntentFilterUniqueDataAttributes">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="*" android:pathPattern="/dcim/.*" />
                <data android:scheme="https" android:host="*" android:pathPattern="/ipam/.*" />
                <data android:scheme="https" android:host="*" android:pathPattern="/circuits/.*" />
                <data android:scheme="https" android:host="*" android:pathPattern="/tenancy/.*" />
                <data
                    android:scheme="https"
                    android:host="*"
                    android:pathPattern="/virtualization/.*" />
                <data android:scheme="https" android:host="*" android:pathPattern="/wireless/.*" />
                <data android:scheme="https" android:host="*" android:pathPattern="/vpn/.*" />
                <data android:scheme="https" android:host="*" android:pathPattern="/extras/.*" />
                <data android:scheme="https" android:host="*" android:pathPattern="/plugins/.*" />
            </intent-filter>

            <!-- NetBox installations on a trusted LAN often still publish sticker URLs over
                 plain HTTP. Keep the same portable chooser behavior for those URLs. -->
            <intent-filter tools:ignore="AppLinkWarning,IntentFilterUniqueDataAttributes">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" android:host="*" android:pathPattern="/dcim/.*" />
                <data android:scheme="http" android:host="*" android:pathPattern="/ipam/.*" />
                <data android:scheme="http" android:host="*" android:pathPattern="/circuits/.*" />
                <data android:scheme="http" android:host="*" android:pathPattern="/tenancy/.*" />
                <data
                    android:scheme="http"
                    android:host="*"
                    android:pathPattern="/virtualization/.*" />
                <data android:scheme="http" android:host="*" android:pathPattern="/wireless/.*" />
                <data android:scheme="http" android:host="*" android:pathPattern="/vpn/.*" />
                <data android:scheme="http" android:host="*" android:pathPattern="/extras/.*" />
                <data android:scheme="http" android:host="*" android:pathPattern="/plugins/.*" />
            </intent-filter>

            <!-- Share links, images, and arbitrary files into the cache-first attachment workflow. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- Setup QR payloads are self-identifying custom-scheme URIs, so another QR reader
                 can hand them back to the app as well as the in-app scanner. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nyetbox" android:host="setup" />
            </intent-filter>

            <!-- App-owned shortcuts such as nyetbox://device/393 and
                 nyetbox://device/asset_tag/%23CZN-0001. The parser also accepts generic built-in
                 and API-style object routes; keeping the filter scheme-only lets it evolve without
                 having to enumerate every NetBox model in the manifest. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nyetbox" />
            </intent-filter>
        </activity>

        <!-- Started by the launcher (a different app/process) both before a placed widget
             instance is confirmed and again from a placed widget's own long-press "Configure"
             entry (see widgetFeatures="reconfigurable" below), so it must be exported. -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.Nyetbox">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Receives APPWIDGET_UPDATE broadcasts from the launcher, so it must be exported. -->
        <receiver android:name=".widget.NyetboxWidgetReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nyetbox_widget_info" />
        </receiver>

        <!-- Same reasoning as WidgetConfigActivity above - a second, separate widget (see
             RackViewGlanceWidget's class doc for why it's not just another content mode of the
             first one). -->
        <activity
            android:name=".widget.RackViewWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.Nyetbox">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- android:label distinguishes this from NyetboxWidgetReceiver in the widget picker,
             which otherwise falls back to the app's own label ("Nyetbox") for both. -->
        <receiver
            android:name=".widget.RackViewWidgetReceiver"
            android:exported="true"
            android:label="@string/rackview_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nyetbox_rackview_widget_info" />
        </receiver>

        <!-- Only ever acts on the androidx.baselineprofile plugin's "benchmarkRelease"/
             "nonMinifiedRelease" build types (both non-debuggable, release-derived) - a no-op on
             the real "debug"/"release" builds shipped to users regardless of who sends this
             broadcast, so exported=true (needed for adb shell's explicit-component am broadcast
             to reliably reach it on API 34 - exported=false plus explicit targeting was
             unreliable in testing) costs nothing on a real install. See BenchmarkSeedReceiver's
             own doc comment (NBC-426). -->
        <receiver
            android:name=".benchmark.BenchmarkSeedReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver" />

        <!-- WorkManager is initialized manually in NyetboxApp (Configuration.Provider) so
             Hilt can inject HiltWorkerFactory into it - disable the default ContentProvider-based
             auto-init to avoid double initialization. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- WorkManager uses this service for CoroutineWorker.setForeground(). The explicit type
             is required on Android 14+ for the long-running NetBox data refresh. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false"
            tools:node="merge" />

        <!-- Grants temporary read access to downloaded attachments (documents, images, ...) so
             they can be opened via ACTION_VIEW in whatever app the user has for that file type -
             see ui/common/FileOpener.kt. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
